# ==============================================================================
# RAILWAY DISTRIBUTED SYSTEM - NHOM 6
# TEP CAU HINH BIEN MOI TRUONG MAU (ENVIRONMENT VARIABLES BASELINE)
# Theo dac ta: docs/specs/08-DEPLOYMENT.md (APPROVED-v1) & Task TV6-D02
# ==============================================================================
# Luu y:
# 1. Day la file mau (.env.example). Khi chay thuc te, copy thanh .env:
#    cp docker/.env.example docker/.env (hoac dung script start-dev.ps1)
# 2. KHONG commit file .env chua thong tin that len Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DINH DANH NODE VA CU MANG (NODE IDENTITY & CLUSTER METADATA)
# ------------------------------------------------------------------------------
# Dinh danh duy nhat cua Node trong he thong Raft (Gia tri hop le: node-1 .. node-5)
NODE_ID=node-1

# Dinh danh cum de phan biet cum test (Chua thay the xac thuc wire-level)
CLUSTER_ID=railway-demo-5

# ------------------------------------------------------------------------------
# 2. CAU HINH CONG MANG (NETWORK BINDING & PORTS - SPEC-08 §3)
# Quy tac: Tach biet hoan toan cong Client va cong Peer Raft.
# ------------------------------------------------------------------------------
# Dia chi va cong socket ma Node lang nghe ket noi tu Client/Monitor trong container
NODE_CLIENT_BIND=0.0.0.0:9100

# Dia chi va cong socket ma Node lang nghe cac RPC Raft giua cac Peer trong container
NODE_PEER_BIND=0.0.0.0:9200

# Dia chi cong khai (Advertise) ma Desktop Client tren Windows Host dung de ket noi
# Che do Dev 1 laptop: node-1 dung 127.0.0.1:9101, node-2 dung 9102, ..., node-5 dung 9105
# Che do Demo LAN 6 laptop: truyen dia chi IP LAN thuc te (vi du: 192.168.10.11:9100)
NODE_ADVERTISE_CLIENT=127.0.0.1:9101

# Dia chi cong khai (Advertise) ma cac Node Peer khac dung de gui RPC Raft den Node nay
# Che do Dev Docker: dung hostname service noi bo Docker (vi du: node-1:9200)
# Che do Demo LAN 6 laptop: truyen dia chi IP LAN thuc te (vi du: 192.168.10.11:9200)
NODE_ADVERTISE_PEER=node-1:9200

# ------------------------------------------------------------------------------
# 3. DANH SACH PEER TRONG CUM RAFT (TOPOLOGY & QUORUM - SPEC-04 & SPEC-08)
# Dinh dang: node-id@host:port (phai gom du 5 node, bao gom chinh node nay)
# Quorum co dinh: 3/5 node (khong doi theo so node online)
# ------------------------------------------------------------------------------
# Che do Dev Docker (Default):
NODE_PEERS=node-1@node-1:9200,node-2@node-2:9200,node-3@node-3:9200,node-4@node-4:9200,node-5@node-5:9200

# Che do Demo LAN 6 laptop (Mau tham khao khi chay tren cac may vat ly khac nhau):
# NODE_PEERS=node-1@192.168.10.11:9200,node-2@192.168.10.12:9200,node-3@192.168.10.13:9200,node-4@192.168.10.14:9200,node-5@192.168.10.15:9200

# ------------------------------------------------------------------------------
# 4. CAU HINH CO SO DU LIEU POSTGRESQL RIENG BIET (SPEC-05 & SPEC-08)
# Quy tac: Moi Node so huu 1 instance PostgreSQL va 1 volume doc lap (Khong dung DB chung)
# ------------------------------------------------------------------------------
DB_HOST=postgres-1
DB_PORT=5432
DB_NAME=railway_node1
DB_USER=railway
DB_PASSWORD=railway_secret_local_only

# ------------------------------------------------------------------------------
# 5. THAM SO THOI GIAN DONG THUAN RAFT VA TIMEOUT MANG (SPEC-04 & SPEC-08 §3.1)
# Don vi: milliseconds (ms)
# ------------------------------------------------------------------------------
# Khoang thoi gian Randomized Election Timeout (khuyen nghi 150ms - 300ms de tranh split-vote)
RAFT_ELECTION_TIMEOUT_MIN_MS=150
RAFT_ELECTION_TIMEOUT_MAX_MS=300

# Chu ky gui Heartbeat (AppendEntries rong) cua Leader (phai nho hon dang ke election timeout)
RAFT_HEARTBEAT_INTERVAL_MS=50

# Thoi gian toi da cho mot ket noi TCP socket (connect timeout)
TCP_CONNECT_TIMEOUT_MS=1000

# Deadline phan hoi mot RPC giua cac node truoc khi coi la timeout
TCP_RESPONSE_DEADLINE_MS=3000
