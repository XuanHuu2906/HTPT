import sys

repo = Path(r'D:\HTPT')
temporary = Path(__file__).parent
empty = temporary / 'empty.env'
empty.write_text('', encoding='utf-8')
compose = ['docker', 'compose', '--env-file', str(empty), '-f', str(repo / 'docker/lan.yml')]
clean = os.environ.copy()
variables = ['NODE_ID', 'LAN_IP', 'NODE_PEERS', 'DB_NAME', 'DB_PASSWORD', 'DB_USER', 'BACKEND_IMAGE',
             'POSTGRES_IMAGE', 'CLUSTER_ID', 'COMPOSE_PROJECT_NAME', 'COMPOSE_FILE', 'COMPOSE_PROFILES',
             'RAFT_ELECTION_TIMEOUT_MIN_MS', 'RAFT_ELECTION_TIMEOUT_MAX_MS', 'RAFT_HEARTBEAT_INTERVAL_MS',
             'TCP_CONNECT_TIMEOUT_MS', 'TCP_RESPONSE_DEADLINE_MS']
for key in variables:
    clean.pop(key, None)

def base(number):
    return dict(clean, NODE_ID=f'node-{number}', LAN_IP=f'198.51.100.{10+number}',
                NODE_PEERS=','.join(f'node-{n}@198.51.100.{10+n}:9200' for n in range(1, 6)),
                DB_NAME=f'railway_node{number}', DB_PASSWORD='CONFIG_ONLY_NOT_A_REAL_CREDENTIAL',
                BACKEND_IMAGE='railway-backend-node:d25-config-only', POSTGRES_IMAGE='postgres:16-alpine')

def run(command, environment, timeout=30):
    return subprocess.run(command, env=environment, cwd=repo, capture_output=True,
                          text=True, encoding='utf-8', errors='replace', timeout=timeout)

print('TV6-D25 CONFIG/GUARD VALIDATION ONLY; all 198.51.100.* addresses are TEST-NET-2 fixtures, not observed hosts.', flush=True)
print('SOURCE_SHA256=' + hashlib.sha256((repo/'docker/lan.yml').read_bytes()).hexdigest(), flush=True)
configs = []
for number in range(1, 6):
    result = run(compose + ['config', '--format', 'json'], base(number))
    assert result.returncode == 0, result.stderr
    config = json.loads(result.stdout)
    assert config['name'] == f'railway-lan-node-{number}'
    assert set(config['services']) == {'backend', 'postgres'}
    backend, pg = config['services']['backend'], config['services']['postgres']
    assert backend['environment']['NODE_ID'] == f'node-{number}'
    assert backend['environment']['DB_NAME'] == pg['environment']['POSTGRES_DB'] == f'railway_node{number}'
    assert backend['environment']['DB_HOST'] == 'postgres'
    assert backend['environment']['DB_PORT'] == '5432'
    assert not pg.get('ports'), 'PostgreSQL must not publish a host port'
    assert {(p['target'], int(p['published']), p['host_ip']) for p in backend['ports']} == {
        (9100, 9100, f'198.51.100.{10+number}'), (9200, 9200, f'198.51.100.{10+number}')}
    assert config['networks']['database']['internal'] is True
    assert set(pg['networks']) == {'database'}
    assert set(backend['networks']) == {'database', 'lan'}
    assert backend['depends_on']['postgres']['condition'] == 'service_healthy'
    assert backend['pull_policy'] == pg['pull_policy'] == 'never'
    assert backend['entrypoint'] == ['/bin/sh', '-ec']
    assert 'exec java -cp' in backend['command'][0] and 'tail -f' not in backend['command'][0]
    assert 'vn.nhom6.railway.node.NodeMain' in backend['command'][0]
    assert config['volumes']['pgdata']['name'] == f'railway-lan-node-{number}_pgdata'
    mounts = pg['volumes']
    assert any(m['type'] == 'volume' and m['source'] == 'pgdata' for m in mounts)
    migration = next(m for m in mounts if m['target'] == '/docker-entrypoint-initdb.d')
    assert migration['read_only'] is True and migration['bind']['create_host_path'] is False
    assert Path(migration['source']).resolve() == (repo/'database/migration').resolve()
    assert not backend.get('profiles') and not pg.get('profiles')
    configs.append(config)
    print(f'CONFIG node-{number} exit=0 ASSERTIONS=PASS; services=2 independentVolume=true; ACTUAL_LAPTOP_DEPLOY=NOT_RUN', flush=True)

for key in ['NODE_ID', 'LAN_IP', 'NODE_PEERS', 'DB_NAME', 'DB_PASSWORD', 'BACKEND_IMAGE']:
    environment = base(1)
    environment.pop(key)
    result = run(compose + ['config', '--quiet'], environment)
    assert result.returncode != 0, f'Missing {key} incorrectly accepted'
    print(f'MISSING_REQUIRED {key} exit={result.returncode} EXPECTED_NONZERO=PASS', flush=True)

# Existing cached image is used ONLY for /bin/sh guard tests with no network,
# ports or volumes. It is NOT assumed to be the current backend candidate.
image = run(['docker', 'image', 'inspect', '--format', '{{.Id}}', 'railway-backend-node:dev'], clean)
assert image.returncode == 0, image.stderr
shell_image = image.stdout.strip()
print(f'GUARD_ONLY_IMAGE={shell_image}; uses shell only, no Java/DB/cluster started', flush=True)

def guard(label, environment, expected):
    # config JSON preserves $$ for round trips; compose unescapes it at create.
    # This test uses docker run, so apply that final unescape explicitly.
    code = configs[0]['services']['backend']['command'][0].replace('$$', '$')
    assert code.count('exec java -cp') == 1
    code = code.split('exec java -cp', 1)[0] + "printf 'GUARD_ONLY_PASS_RUNTIME_NOT_STARTED\\n'\n"
    command = ['docker', 'run', '--rm', '--pull', 'never', '--network', 'none', '--entrypoint', '/bin/sh']
    for key in ['NODE_ID', 'LAN_IP', 'NODE_PEERS', 'DB_NAME']:
        command += ['--env', f'{key}={environment[key]}']
    command += [shell_image, '-ec', code]
    result = run(command, clean)
    assert result.returncode == expected, (label, result.returncode, result.stdout, result.stderr)
    print(f'GUARD {label} exit={result.returncode} expected={expected} PASS; output={(result.stdout+result.stderr).strip()}', flush=True)

for number in range(1, 6):
