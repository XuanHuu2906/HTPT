import hashlib
import json
import os
from pathlib import Path
import secrets
import socket
import struct
import subprocess
import time
import uuid
from datetime import datetime, timezone

repo = Path(r'D:\HTPT')
temporary = Path(__file__).parent
project = 'tv6-d25-local-' + uuid.uuid4().hex[:8]
password = secrets.token_hex(24)
environment = os.environ.copy()
environment.update(NODE_ID='node-1', LAN_IP='127.0.0.1', DB_NAME='railway_node1',
                   DB_USER='railway', DB_PASSWORD=password,
                   BACKEND_IMAGE='railway-backend-node:tv6-d25-6addad37e7ff',
                   POSTGRES_IMAGE='postgres:16-alpine',
                   NODE_PEERS='node-1@127.0.0.1:9200,' + ','.join(f'node-{n}@198.51.100.{10+n}:9200' for n in range(2,6)))
for key in ['COMPOSE_FILE', 'COMPOSE_PROFILES', 'COMPOSE_PROJECT_NAME', 'CLUSTER_ID',
            'RAFT_ELECTION_TIMEOUT_MIN_MS', 'RAFT_ELECTION_TIMEOUT_MAX_MS', 'RAFT_HEARTBEAT_INTERVAL_MS',
            'TCP_CONNECT_TIMEOUT_MS', 'TCP_RESPONSE_DEADLINE_MS']:
    environment.pop(key, None)
command = ['docker', 'compose', '-p', project, '--env-file', str(temporary/'empty.env'), '-f', str(repo/'docker/lan.yml')]

def run(label, args, timeout=25, required=True):
    print('COMMAND ' + label + ': ' + subprocess.list2cmdline(command + args), flush=True)
    response = subprocess.run(command + args, cwd=repo, env=environment, capture_output=True,
                              text=True, encoding='utf-8', errors='replace', timeout=timeout)
    output = (response.stdout + response.stderr).replace(password, '<REDACTED>')
    print(f'EXIT {label}={response.returncode}\n{output}', flush=True)
    if required and response.returncode != 0:
        raise RuntimeError(f'{label} failed with exit={response.returncode}')
    return response

def read_exact(connection, size):
    response = b''
    while len(response) < size:
        block = connection.recv(size - len(response))
        if not block:
            raise RuntimeError('incomplete frame')
        response += block
    return response

print('MODE=LOCAL_PAIR_SMOKE_ON_LAPTOP6; NOT a deployment on physical laptops1..5; no quorum or booking claim.', flush=True)
print('PROJECT=' + project + '; loopback binds only; other peers use documentation TEST-NET-2 addresses, not real inventory.', flush=True)
print('SOURCE_SHA256=' + hashlib.sha256((repo/'docker/lan.yml').read_bytes()).hexdigest(), flush=True)
success = False
try:
    run('up-local-pair', ['up', '-d', '--wait', '--wait-timeout', '90'], timeout=120)
    states = run('ps-local-pair', ['ps', '--all', '--format', 'json']).stdout
    containers = [json.loads(line) for line in states.splitlines() if line.strip()]
    if len(containers) == 1 and isinstance(containers[0], list):
        containers = containers[0]
    assert {c['Service'] for c in containers} == {'backend', 'postgres'}
    assert all(c['State'] == 'running' and c['Health'] == 'healthy' for c in containers)
    sql = "BEGIN TRANSACTION READ ONLY; SELECT json_build_object('database',current_database(),'seats',(SELECT count(*) FROM seats WHERE trip_id='SE-001'),'seatIds',(SELECT json_agg(seat_id ORDER BY seat_id) FROM seats WHERE trip_id='SE-001'),'tickets',(SELECT count(*) FROM tickets),'requests',(SELECT count(*) FROM request_results),'lastApplied',(SELECT last_applied FROM raft_apply_progress WHERE singleton=1),'raftRows',(SELECT count(*) FROM raft_meta)); COMMIT;"
    actual = run('sql-readonly', ['exec', '-T', 'postgres', 'psql', '-X', '-qAt', '-v', 'ON_ERROR_STOP=1',
                                '-U', 'railway', '-d', 'railway_node1', '-c', sql]).stdout
    row = json.loads(next(line for line in actual.splitlines() if line.startswith('{')))
    assert row['database'] == 'railway_node1' and row['seats'] == 10
    assert row['seatIds'] == [f'G{n:02d}' for n in range(1,11)]
    assert row['tickets'] == row['requests'] == row['lastApplied'] == 0 and row['raftRows'] == 1
    message_id = str(uuid.uuid4())
    request = dict(protocolVersion=1, messageId=message_id, correlationId=None, type='NODE_STATUS',
                   senderId='monitor-tv6-d25-local', sentAt=datetime.now(timezone.utc).isoformat(timespec='milliseconds').replace('+00:00','Z'), payload={})
    body = json.dumps(request).encode('utf-8')
    with socket.create_connection(('127.0.0.1', 9100), timeout=3) as connection:
        connection.settimeout(3)
        connection.sendall(struct.pack('!I', len(body)) + body)
        size = struct.unpack('!I', read_exact(connection, 4))[0]
        assert 0 < size <= 1048576
        response = json.loads(read_exact(connection, size))
    print('REAL_LOCAL_NODE_STATUS=' + json.dumps(response), flush=True)
    assert response['correlationId'] == message_id and response['type'] == 'NODE_STATUS_RESPONSE'
    assert response['senderId'] == response['payload']['nodeId'] == 'node-1'
    assert response['payload']['storageHealthy'] is True
    assert response['payload']['commitIndex'] == response['payload']['lastApplied'] == 0
    print('LOCAL_STARTUP_MIGRATION_TCP=PASS; PostgreSQL and Java process real; physical five-laptop deploy and G6=NOT_RUN', flush=True)
    success = True
finally:
    # Keep collecting/cleanup independent even when startup/verification fails.
    for label, arguments in [('logs-local-pair', ['logs', '--no-color', '--timestamps', '--tail', '160']),
                             ('down-local-pair-KEEP-VOLUME', ['down', '--timeout', '15'])]:
        try:
            result = run(label, arguments, timeout=45, required=False)
            if result.returncode:
                success = False
        except Exception as problem:
            print(f'CLEANUP_FAILURE {label}: {problem}', flush=True)
            success = False
    result = subprocess.run(['docker', 'volume', 'inspect', '--format', '{{.Name}}', project+'_pgdata'],
                            capture_output=True, text=True, timeout=15)
    print(f'RETAINED_VOLUME exit={result.returncode} {result.stdout.strip()}', flush=True)
    if result.returncode:
        success = False
print('FINAL_LOCAL_PAIR=' + ('PASS' if success else 'FAIL') + '; PHYSICAL_5_LAPTOP_DEPLOY=BLOCKED; G6=NOT_RUN', flush=True)
raise SystemExit(0 if success else 1)

