bad = base(1); bad['NODE_PEERS'] = ','.join(bad['NODE_PEERS'].split(',')[:4]); guard('reject-four-voters', bad, 2)
bad = base(1); bad['NODE_PEERS'] += ',node-6@198.51.100.16:9200'; guard('reject-six-voters', bad, 2)
bad = base(1); bad['LAN_IP'] = '198.51.100.99'; guard('reject-self-address-mismatch', bad, 2)
bad = base(1); bad['NODE_PEERS'] = bad['NODE_PEERS'].replace(':9200', ':9100'); guard('reject-client-port-in-peer-map', bad, 2)
print('FINAL CONFIG_GUARDS=PASS; config cases=5, missing variable cases=6, shell guard cases=12. PHYSICAL_5_LAPTOP_DEPLOY=NOT_RUN; G6=NOT_RUN', flush=True)

