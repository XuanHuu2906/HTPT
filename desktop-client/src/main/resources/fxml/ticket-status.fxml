<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="ticketStatusRoot" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.nhom6.railway.client.controller.TicketStatusController"
      spacing="14.0" style="-fx-padding: 18 24; -fx-background-color: #f8fafc;"
      stylesheets="@../css/railway.css">

    <!-- 1. HEADER: Nút quay lại, Tiêu đề màn hình và Nhãn nguồn dữ liệu -->
    <HBox alignment="CENTER_LEFT" spacing="14.0">
        <children>
            <Button fx:id="backBtn" onAction="#onBackClicked" text="⬅ Quay lại màn hình chính"
                    minWidth="-Infinity" styleClass="btn-back" />
            <VBox spacing="2.0">
                <children>
                    <Label text="TRA CỨU VÀ QUẢN LÝ VÉ CHUYẾN SE-001"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                    <Label text="Tra cứu kết quả yêu cầu theo Request ID (GET_REQUEST_RESULT) và quản lý vé đã xác nhận"
                           style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="mockBadgeLabel" text="REAL / SOCKET" minWidth="-Infinity" styleClass="badge-ticket-confirmed" />
        </children>
    </HBox>

    <!-- 2. BANNER CHẾ ĐỘ DỮ LIỆU & CẢNH BÁO -->
    <VBox spacing="6.0">
        <children>
            <HBox fx:id="bannerBox" alignment="CENTER_LEFT" spacing="10.0"
                  style="-fx-background-color: #eff6ff; -fx-padding: 8 14; -fx-background-radius: 6; -fx-border-color: #bfdbfe; -fx-border-radius: 6;">
                <children>
                    <Label fx:id="bannerTitleLabel" text="ℹ NGUỒN DỮ LIỆU:" minWidth="-Infinity"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #1d4ed8;" />
                    <Label fx:id="bannerTextLabel" text="Bảng hiển thị các vé đã xác nhận (CONFIRMED) trong phiên hoặc khôi phục từ nhật ký bền vững của máy trạm này."
                           wrapText="true" HBox.hgrow="ALWAYS" style="-fx-font-size: 11px; -fx-text-fill: #1e3a8a;" />
                </children>
            </HBox>
            <HBox fx:id="historyBlockedBox" alignment="CENTER_LEFT" spacing="8.0"
                  style="-fx-background-color: #f1f5f9; -fx-padding: 6 12; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;">
                <children>
                    <Label text="ℹ LỊCH SỬ NÂNG CAO:" minWidth="-Infinity"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                    <Label fx:id="historyBlockedLabel" text="Lịch sử vé nâng cao chưa có contract được duyệt (BLOCKED/P1) — Bảng chỉ hiển thị vé đã xác nhận của ứng dụng này."
                           wrapText="true" HBox.hgrow="ALWAYS" style="-fx-font-size: 11px; -fx-text-fill: #334155;" />
                </children>
            </HBox>
        </children>
    </VBox>

    <!-- 3. KHU VỰC TÌM KIẾM & TRA CỨU VÉ -->
    <VBox spacing="10.0"
          style="-fx-background-color: #ffffff; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <Label text="Tìm kiếm:" minWidth="-Infinity" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                    <ComboBox fx:id="searchTypeCombo" prefWidth="185.0" styleClass="search-combobox" />
                    <TextField fx:id="searchField" HBox.hgrow="ALWAYS"
                               promptText="Nhập Request ID (UUID) để truy vấn cụm máy chủ hoặc Ticket ID để lọc cục bộ..."
                               style="-fx-font-size: 12px; -fx-padding: 6 10; -fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
                    <Button fx:id="searchBtn" onAction="#onSearchClicked" text="🔍 Tra cứu"
                            minWidth="-Infinity" styleClass="btn-primary" />
                    <Button fx:id="clearSearchBtn" onAction="#onClearSearchClicked" text="⟲ Hiện tất cả"
                            minWidth="-Infinity" styleClass="btn-reset" />
                    <ProgressIndicator fx:id="searchProgressIndicator" prefWidth="18.0" prefHeight="18.0"
                                       visible="false" managed="false" />
                </children>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <children>
                    <Label fx:id="searchResultLabel" text="Nhập Request ID để tra cứu kết quả xử lý trên máy chủ."
                           wrapText="true" styleClass="search-msg-muted" />
                </children>
            </HBox>
        </children>
    </VBox>

    <!-- 4. BẢNG DANH SÁCH VÉ (TableView) -->
    <TableView fx:id="ticketTableView" VBox.vgrow="ALWAYS" styleClass="ticket-table-view">
        <columns>
            <TableColumn fx:id="colRequestId" text="Mã yêu cầu (Request ID)" prefWidth="155.0" />
            <TableColumn fx:id="colTicketId" text="Mã vé (Ticket ID)" prefWidth="145.0" />
            <TableColumn fx:id="colSeat" text="Ghế" prefWidth="55.0" />
            <TableColumn fx:id="colTrip" text="Chuyến" prefWidth="75.0" />
            <TableColumn fx:id="colPassenger" text="Hành khách" prefWidth="145.0" />
            <TableColumn fx:id="colTime" text="Thời gian đặt" prefWidth="130.0" />
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="135.0" />
            <TableColumn fx:id="colMock" text="Nguồn" prefWidth="110.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- 5. THANH THAO TÁC DƯỚI: Chi tiết vé được chọn & Nút Hủy vé -->
    <HBox alignment="CENTER_LEFT" spacing="14.0"
          style="-fx-background-color: #ffffff; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <children>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="Vé đang chọn trong bảng:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
                    <Label fx:id="selectedTicketSummaryLabel" text="(Chưa chọn vé nào — Vui lòng nhấp vào một dòng trong bảng)"
                           wrapText="true" styleClass="ticket-summary-default" />
                </children>
            </VBox>

            <Button fx:id="cancelTicketBtn" onAction="#onCancelTicketClicked" text="❌ Hủy vé đã chọn"
                    minWidth="-Infinity" styleClass="btn-cancel-ticket" disable="true" />
        </children>
    </HBox>

</VBox>
