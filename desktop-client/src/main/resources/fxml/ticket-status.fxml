<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.nhom6.railway.client.controller.TicketStatusController"
      spacing="14.0" style="-fx-padding: 18 24; -fx-background-color: #f8fafc;"
      stylesheets="@../css/railway.css">

    <!-- 1. HEADER: Nút quay lại, Tiêu đề màn hình và Nhãn MOCK DATA -->
    <HBox alignment="CENTER_LEFT" spacing="14.0">
        <children>
            <Button fx:id="backBtn" onAction="#onBackClicked" text="⬅ Quay lại màn hình chính"
                    styleClass="btn-back" />
            <VBox spacing="2.0">
                <children>
                    <Label text="TRA CỨU VÀ QUẢN LÝ VÉ (TASK D06)"
                           style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                    <Label text="Xem danh sách vé, tra cứu theo Request ID / Ticket ID và mô phỏng hủy vé MOCK"
                           style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="mockBadgeLabel" text="MOCK DATA — D06" styleClass="badge-mock" />
        </children>
    </HBox>

    <!-- 2. BANNER CẢNH BÁO MOCK: Không ngụ ý thao tác đã gửi backend -->
    <HBox alignment="CENTER_LEFT" spacing="10.0"
          style="-fx-background-color: #fffbeb; -fx-padding: 8 14; -fx-background-radius: 6; -fx-border-color: #fde68a; -fx-border-radius: 6;">
        <children>
            <Label text="ℹ THÔNG BÁO MÔ PHỎNG:"
                   style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #92400e;" />
            <Label text="Tất cả dữ liệu vé bên dưới là dữ liệu giả lập (MOCK) lưu trong bộ nhớ máy trạm, không ghi DB hay gửi qua mạng."
                   style="-fx-font-size: 11px; -fx-text-fill: #78350f;" />
        </children>
    </HBox>

    <!-- 3. KHU VỰC TÌM KIẾM & TRA CỨU VÉ -->
    <VBox spacing="10.0"
          style="-fx-background-color: #ffffff; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <Label text="Tìm kiếm:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #334155;" />
                    <ComboBox fx:id="searchTypeCombo" prefWidth="180.0" styleClass="mock-combobox" />
                    <TextField fx:id="searchField" HBox.hgrow="ALWAYS"
                               promptText="Nhập Request ID (VD: REQ-20261105-001) hoặc Ticket ID (VD: TCK-SE001-G02)..."
                               style="-fx-font-size: 12px; -fx-padding: 6 10; -fx-background-radius: 5; -fx-border-color: #cbd5e1; -fx-border-radius: 5;" />
                    <Button fx:id="searchBtn" onAction="#onSearchClicked" text="🔍 Tra cứu"
                            styleClass="btn-primary" />
                    <Button fx:id="clearSearchBtn" onAction="#onClearSearchClicked" text="⟲ Hiện tất cả"
                            styleClass="btn-reset" />
                    <ProgressIndicator fx:id="searchProgressIndicator" prefWidth="18.0" prefHeight="18.0"
                                       visible="false" managed="false" />
                </children>
            </HBox>

            <!-- Nhãn phản hồi kết quả tra cứu -->
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <children>
                    <Label fx:id="searchResultLabel" text="Hiển thị tất cả 7 vé trong danh sách MOCK."
                           style="-fx-font-size: 11px; -fx-text-fill: #64748b; -fx-font-style: italic;" />
                </children>
            </HBox>
        </children>
    </VBox>

    <!-- 4. BẢNG DANH SÁCH VÉ (TableView) -->
    <TableView fx:id="ticketTableView" VBox.vgrow="ALWAYS" styleClass="ticket-table-view">
        <columns>
            <TableColumn fx:id="colRequestId" text="Mã yêu cầu (Request ID)" prefWidth="155.0" />
            <TableColumn fx:id="colTicketId" text="Mã vé (Ticket ID)" prefWidth="145.0" />
            <TableColumn fx:id="colSeat" text="Ghế" prefWidth="55.0" />
            <TableColumn fx:id="colTrip" text="Chuyến" prefWidth="75.0" />
            <TableColumn fx:id="colPassenger" text="Hành khách" prefWidth="145.0" />
            <TableColumn fx:id="colTime" text="Thời gian đặt" prefWidth="130.0" />
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="135.0" />
            <TableColumn fx:id="colMock" text="Ghi chú" prefWidth="110.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- 5. THANH THAO TÁC DƯỚI: Chi tiết vé được chọn & Nút Hủy vé -->
    <HBox alignment="CENTER_LEFT" spacing="14.0"
          style="-fx-background-color: #ffffff; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
        <children>
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="Vé đang chọn trong bảng:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #64748b;" />
                    <Label fx:id="selectedTicketSummaryLabel" text="(Chưa chọn vé nào — Vui lòng nhấp vào một dòng trong bảng)"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                </children>
            </VBox>

            <!-- Nút Hủy vé: Chỉ bật khi chọn vé CONFIRMED -->
            <Button fx:id="cancelTicketBtn" onAction="#onCancelTicketClicked" text="❌ Hủy vé đã chọn"
                    styleClass="btn-cancel-ticket" disable="true" />
        </children>
    </HBox>

</VBox>

