<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.nhom6.railway.client.controller.MainController"
            prefWidth="1020.0" prefHeight="660.0"
            style="-fx-background-color: #f8fafc; -fx-font-family: 'Segoe UI', Tahoma, sans-serif;">

    <!-- TOP: Tiêu đề ứng dụng + Nhãn MOCK nổi bật -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0"
              style="-fx-background-color: #1e293b; -fx-padding: 12 24; -fx-border-color: #334155; -fx-border-width: 0 0 1 0;">
            <children>
                <Label fx:id="tripTitleLabel" text="HỆ THỐNG BÁN VÉ TÀU CAO TỐC — CHUYẾN SE-001"
                       style="-fx-text-fill: #ffffff; -fx-font-size: 17px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="CHẾ ĐỘ:" style="-fx-text-fill: #cbd5e1; -fx-font-size: 12px; -fx-font-weight: bold;" />
                <Label fx:id="mockBadgeLabel" text="MOCK DATA"
                       style="-fx-background-color: #f59e0b; -fx-text-fill: #78350f; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 4 14; -fx-background-radius: 6; -fx-border-color: #d97706; -fx-border-radius: 6;" />
            </children>
        </HBox>
    </top>

    <!-- LEFT: Vùng điều hướng (Placeholder các chức năng) -->
    <left>
        <VBox fx:id="navRegion" prefWidth="190.0" spacing="10.0"
              style="-fx-background-color: #0f172a; -fx-padding: 20 12; -fx-border-color: #334155; -fx-border-width: 0 1 0 0;">
            <children>
                <Label text="ĐIỀU HƯỚNG"
                       style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 0 0 4 6;" />

                <Button fx:id="navTripBtn" maxWidth="Infinity" alignment="BASELINE_LEFT" text="🚆 Chọn chuyến"
                        style="-fx-background-color: #1e293b; -fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 6; -fx-cursor: hand;" />

                <Button fx:id="navSeatBtn" maxWidth="Infinity" alignment="BASELINE_LEFT" text="💺 Chọn ghế (10 ghế)"
                        style="-fx-background-color: #3b82f6; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 6; -fx-cursor: hand;" />

                <Button fx:id="navPaymentBtn" maxWidth="Infinity" alignment="BASELINE_LEFT" text="💳 Thanh toán"
                        style="-fx-background-color: #1e293b; -fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 6; -fx-cursor: hand;" />

                <Button fx:id="navMyTicketsBtn" maxWidth="Infinity" alignment="BASELINE_LEFT" text="🎫 Vé của tôi"
                        style="-fx-background-color: #1e293b; -fx-text-fill: #cbd5e1; -fx-font-size: 13px; -fx-padding: 10 12; -fx-background-radius: 6; -fx-cursor: hand;" />

                <Separator style="-fx-opacity: 0.3; -fx-padding: 10 0;" />

                <VBox spacing="4.0" style="-fx-padding: 8 6; -fx-background-color: #1e293b; -fx-background-radius: 6;">
                    <children>
                        <Label text="Thông tin hệ thống:" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px; -fx-font-weight: bold;" />
                        <Label text="• Giai đoạn: D01 (MOCK)" style="-fx-text-fill: #cbd5e1; -fx-font-size: 11px;" />
                        <Label text="• Backend: Chưa kết nối" style="-fx-text-fill: #fbbf24; -fx-font-size: 11px;" />
                        <Label text="• Nhóm 6 - HTPT" style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;" />
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- CENTER: Lưới 10 ghế (GridPane 2x5) + Khu vực thông tin -->
    <center>
        <VBox spacing="16.0" style="-fx-padding: 20;">
            <children>
                <!-- Card thông tin chuyến tàu -->
                <HBox alignment="CENTER_LEFT" spacing="15.0"
                      style="-fx-background-color: #ffffff; -fx-padding: 14 18; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <Label text="CHUYẾN TÀU SE-001" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                                <Label text="Hà Nội (06:00) ➔ TP. Hồ Chí Minh (19:30) | Toa 01 - Khoang 10 ghế VIP"
                                       style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Kết nối: MOCK OFFLINE"
                               style="-fx-background-color: #f1f5f9; -fx-text-fill: #475569; -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 4 10; -fx-background-radius: 4; -fx-border-color: #cbd5e1; -fx-border-radius: 4;" />
                    </children>
                </HBox>

                <!-- Card Sơ đồ ghế 10 ghế G01 - G10 -->
                <VBox spacing="14.0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #ffffff; -fx-padding: 18; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label text="SƠ ĐỒ 10 GHẾ (G01 – G10)"
                                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0f172a;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <!-- Chú thích (Legend) -->
                                <HBox spacing="16.0" alignment="CENTER_RIGHT">
                                    <children>
                                        <HBox spacing="6.0" alignment="CENTER">
                                            <children>
                                                <Region prefWidth="14.0" prefHeight="14.0"
                                                        style="-fx-background-color: #ecfdf5; -fx-border-color: #10b981; -fx-border-radius: 3; -fx-background-radius: 3;" />
                                                <Label text="Trống (AVAILABLE)" style="-fx-font-size: 11px; -fx-text-fill: #065f46;" />
                                            </children>
                                        </HBox>
                                        <HBox spacing="6.0" alignment="CENTER">
                                            <children>
                                                <Region prefWidth="14.0" prefHeight="14.0"
                                                        style="-fx-background-color: #fef2f2; -fx-border-color: #ef4444; -fx-border-radius: 3; -fx-background-radius: 3;" />
                                                <Label text="Đã đặt (BOOKED)" style="-fx-font-size: 11px; -fx-text-fill: #991b1b;" />
                                            </children>
                                        </HBox>
                                        <HBox spacing="6.0" alignment="CENTER">
                                            <children>
                                                <Region prefWidth="14.0" prefHeight="14.0"
                                                        style="-fx-background-color: #fffbeb; -fx-border-color: #f59e0b; -fx-border-radius: 3; -fx-background-radius: 3;" />
                                                <Label text="Đang chọn (SELECTED)" style="-fx-font-size: 11px; -fx-text-fill: #92400e;" />
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <Separator style="-fx-opacity: 0.5;" />

                        <!-- Container lưới 10 ghế (GridPane 2 hàng x 5 cột) -->
                        <GridPane fx:id="seatGridContainer" alignment="CENTER" hgap="16.0" vgap="16.0"
                                  VBox.vgrow="ALWAYS" style="-fx-padding: 10;">
                            <!-- Các ghế G01 đến G10 được khởi tạo động bởi MainController -->
                        </GridPane>
                    </children>
                </VBox>

                <!-- Form thao tác đặt vé (Placeholder MOCK) -->
                <HBox alignment="CENTER_LEFT" spacing="10.0"
                      style="-fx-background-color: #ffffff; -fx-padding: 12 16; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                    <children>
                        <Label fx:id="selectedSeatLabel" text="Ghế: (Chưa chọn)" minWidth="-Infinity"
                               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />

                        <Separator orientation="VERTICAL" style="-fx-padding: 0 4;" />

                        <Label text="Họ tên:" minWidth="-Infinity"
                               style="-fx-font-size: 13px; -fx-text-fill: #475569;" />

                        <TextField fx:id="passengerNameField" promptText="Tên hành khách (demo)..."
                                   prefWidth="190.0" minWidth="150.0"
                                   style="-fx-padding: 8 10; -fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6;" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="bookSeatBtn" text="Đặt vé (MOCK)" minWidth="-Infinity"
                                style="-fx-background-color: #10b981; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 13px; -fx-padding: 8 16; -fx-background-radius: 6; -fx-cursor: hand;" />

                        <Button fx:id="refreshBtn" text="Làm mới" minWidth="-Infinity"
                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-size: 13px; -fx-padding: 8 14; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-cursor: hand;" />

                        <Button fx:id="lookupBtn" text="Tra cứu" minWidth="-Infinity"
                                style="-fx-background-color: #f1f5f9; -fx-text-fill: #334155; -fx-font-size: 13px; -fx-padding: 8 14; -fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-cursor: hand;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>

    <!-- BOTTOM: Thanh trạng thái -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0"
              style="-fx-background-color: #e2e8f0; -fx-padding: 6 16; -fx-border-color: #cbd5e1; -fx-border-width: 1 0 0 0;">
            <children>
                <Label text="Trạng thái:" style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #475569;" />
                <Label fx:id="statusMessageLabel" text="Hệ thống sẵn sàng ở chế độ MOCK (D01). Không gọi mạng / không kết nối backend."
                       style="-fx-font-size: 11px; -fx-text-fill: #1e293b;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label text="v1.0.0-MOCK | Nhóm 6" style="-fx-font-size: 11px; -fx-text-fill: #64748b;" />
            </children>
        </HBox>
    </bottom>

</BorderPane>
